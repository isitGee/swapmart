{
  "name": "@swapmart/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "node --experimental-strip-types src/db/cli.ts migrate",
    "db:seed": "node --experimental-strip-types src/db/cli.ts seed",
    "db:reset": "node --experimental-strip-types src/db/cli.ts reset --force",
    "db:status": "node --experimental-strip-types src/db/cli.ts status",
    "admin:create": "node --experimental-strip-types src/db/cli.ts admin:create",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest --config vitest.unit.config.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.0.2",
    "@swapmart/shared": "*",
    "compression": "1.7.5",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "5.1.0",
    "express-rate-limit": "7.5.0",
    "helmet": "8.1.0",
    "multer": "2.0.2",
    "nodemailer": "6.10.1",
    "pg": "8.16.3",
    "pino": "9.5.0",
    "pino-http": "10.3.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/compression": "1.7.5",
    "@types/cookie-parser": "1.4.8",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/multer": "2.0.0",
    "@types/node": "22.10.2",
    "@types/nodemailer": "6.4.17",
    "@types/pg": "8.11.10",
    "@types/supertest": "6.0.2",
    "supertest": "7.1.4",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
