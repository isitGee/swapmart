# =============================================================================
# SWAPMART — environment template.
# Copy to `.env` (backend) and `apps/web/.env.local` (frontend) as needed.
# NEVER commit a filled-in .env file, and never reuse these example values
# outside local development.
# =============================================================================

# ---------------------------------------------------------------------------
# Core runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Public URLs. The web app calls the API through a same-origin Next.js rewrite
# (`/api/v1/*` -> `${API_URL}/api/v1/*`), which keeps cookies same-site.
API_URL=http://localhost:4000
APP_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
# Comma-separated allow-list used by the API CORS layer. Empty = same-origin only.
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Database (PostgreSQL). Managed service in production (Railway/Neon/RDS...).
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://swapmart:swapmart@127.0.0.1:5432/swapmart
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# Test database (used by `npm run test:integration` / `test:e2e`).
TEST_DATABASE_URL=postgres://swapmart:swapmart@127.0.0.1:5432/swapmart_test

# ---------------------------------------------------------------------------
# Security secrets — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ---------------------------------------------------------------------------
# 32-byte key. AES-256-GCM key used to encrypt device identifiers at rest.
IDENTIFIER_ENCRYPTION_KEY=
# 32-byte key. HMAC-SHA256 key used for duplicate-detection fingerprints.
IDENTIFIER_HASH_SECRET=
# Optional: comma-separated list of trusted reverse-proxy IPs/CIDRs.
TRUST_PROXY=
# Session lifetime in days.
SESSION_TTL_DAYS=30

# Rate limiting (requests per window per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=10
SENSITIVE_RATE_LIMIT_MAX=30

# ---------------------------------------------------------------------------
# Email (verification + password recovery).
# EMAIL_TRANSPORT: auto | smtp | log
#   auto -> uses SMTP when SMTP_URL is set, otherwise the "log" transport.
#   log  -> development transport: messages are recorded in the `email_outbox`
#           table and printed to the server log. Verification links are printed
#           in development only. Production MUST use smtp.
# ---------------------------------------------------------------------------
EMAIL_TRANSPORT=auto
SMTP_URL=
MAIL_FROM="SWAPMART <no-reply@swapmart.co.tz>"
EMAIL_VERIFICATION_REQUIRED=true

# ---------------------------------------------------------------------------
# Media storage (device images + private verification evidence).
# MEDIA_STORAGE: auto | cloudinary | local
#   auto -> Cloudinary when the credentials below are present, otherwise the
#           local disk driver (development/self-host fallback only).
# ---------------------------------------------------------------------------
MEDIA_STORAGE=auto
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=swapmart
CLOUDINARY_UPLOAD_TIMEOUT_MS=20000
# Where the local fallback driver stores files (kept out of version control).
LOCAL_MEDIA_DIR=
# Public listing image limits
MAX_IMAGE_BYTES=5242880
MAX_IMAGES_PER_LISTING=8
# Private verification evidence limits
MAX_EVIDENCE_BYTES=10485760
MAX_EVIDENCE_FILES=5

# ---------------------------------------------------------------------------
# External stolen/blacklist check provider.
# STOLEN_CHECK_PROVIDER: none | http
#   none -> no authoritative provider configured. Submissions are marked
#           "not performed (provider not configured)" and routed to manual
#           review. SWAPMART never fabricates a successful blacklist check.
#   http -> generic JSON provider configured by the two variables below.
# ---------------------------------------------------------------------------
STOLEN_CHECK_PROVIDER=none
STOLEN_CHECK_URL=
STOLEN_CHECK_API_KEY=
STOLEN_CHECK_TIMEOUT_MS=6000

# ---------------------------------------------------------------------------
# Administrator provisioning (used ONLY by `npm run admin:create`).
# Never enable public registration of administrators.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@swapmart.co.tz
# Quote any value that contains a space or a '#' character (dotenv treats an
# unquoted '#' as the start of a comment, silently truncating the secret).
ADMIN_PASSWORD=
ADMIN_FULL_NAME="SWAPMART Administrator"

# Password for the fictional demo members created by `npm run db:seed`.
# Leave blank to use the documented development default; never reuse it in a
# real deployment (the seed summary says which one is in use).
DEMO_PASSWORD=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Frontend (apps/web/.env.local)
# ---------------------------------------------------------------------------
# Server-side base URL used by React Server Components to talk to the API.
# NEXT_PUBLIC_API_BASE is intentionally left empty: the browser always uses the
# same-origin path `/api/v1` (proxied by Next.js), so no backend host is ever
# exposed to the browser.
NEXT_PUBLIC_API_BASE=
INTERNAL_API_URL=http://localhost:4000
